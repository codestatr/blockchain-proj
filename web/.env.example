# Copy this file to .env.local after deployment. Public values are safe for browser use.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_LOCAL_CONTRACT_ADDRESS=
NEXT_PUBLIC_BASE_SEPOLIA_CONTRACT_ADDRESS=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_APP_URL=https://wastesystem.netlify.app

# Server-only API values. Never add the NEXT_PUBLIC_ prefix to these secrets.
ADMIN_PRIVATE_KEY=
LOCAL_RPC_URL=http://127.0.0.1:8545
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Set this to a Neon Postgres connection string to use the hosted auth database.
# If unset, local development stores accounts in web/data/auth.sqlite.
DATABASE_URL=

# Optional local SQLite path, used only when DATABASE_URL is unset.
# AUTH_DB_PATH=
